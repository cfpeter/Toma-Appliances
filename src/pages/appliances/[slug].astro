---
/**
 * One appliance.
 *
 * There is no cart and no checkout: the page exists to get a specific person
 * to text about a specific machine. So the photo, the price, the condition
 * and the two contact buttons are the page, and everything else is support.
 */
import AdminBar from '../../components/public/AdminBar.astro'
import PhotoGallery from '../../components/public/PhotoGallery.astro'
import ProductCard from '../../components/public/ProductCard.astro'
import Public from '../../layouts/Public.astro'
import { conditionBadgeClass, conditionLabel, conditionNote } from '../../lib/condition.ts'
import { photoUrl } from '../../lib/images/keys.ts'
import { formatCents } from '../../lib/money.ts'
import { getBusiness, productEnquiry, smsHref, stockLabel, telHref } from '../../lib/public.ts'
import { createPublicClient } from '../../lib/supabase/server.ts'

const { slug } = Astro.params
const supabase = createPublicClient()

const [business, { data: product }] = await Promise.all([
  getBusiness(),
  supabase.from('catalog').select('*').eq('slug', slug).maybeSingle(),
])

if (!product) return Astro.redirect('/appliances', 302)

const [{ data: photos }, { data: related }, { data: cats }] = await Promise.all([
  supabase
    .from('product_photos')
    .select('id, r2_key, format, alt_text')
    .eq('product_id', product.id)
    .order('sort_order'),
  supabase
    .from('catalog')
    .select('*')
    .eq('category_id', product.category_id)
    .neq('id', product.id)
    .eq('status', 'active')
    .limit(4),
  supabase.from('categories').select('id, name, slug'),
])

const shots = photos ?? []

// Photos for the "more like this" row, in one query rather than four.
const relatedIds = (related ?? []).map((r) => r.id)
const { data: relatedPhotos } = relatedIds.length
  ? await supabase
      .from('product_photos')
      .select('product_id, r2_key, format')
      .in('product_id', relatedIds)
      .order('sort_order')
  : { data: [] }
const relatedPhoto = new Map<string, { r2_key: string; format: 'webp' | 'jpeg' }>()
for (const r of relatedPhotos ?? []) if (!relatedPhoto.has(r.product_id)) relatedPhoto.set(r.product_id, r)
const category = (cats ?? []).find((c) => c.id === product.category_id)
const sold = product.status === 'sold' || product.qty_available <= 0
const tel = telHref(business.phone)
const site = Astro.site ?? new URL('http://localhost:4321')
const listingUrl = new URL(Astro.url.pathname, site).toString()

const sms = smsHref(
  business.phone,
  productEnquiry({
    name: product.name,
    price: product.price_cents ? formatCents(product.price_cents) : undefined,
    url: listingUrl,
  }),
)
const heroImage = shots[0] ? new URL(photoUrl(shots[0].r2_key, 'full', shots[0].format), site).toString() : undefined

const description = [
  product.brand,
  product.name,
  product.price_cents ? `at ${formatCents(product.price_cents)}` : '',
  `— ${conditionLabel(product.condition).toLowerCase()}.`,
  business.warranty,
]
  .filter(Boolean)
  .join(' ')
  .slice(0, 300)

// Product structured data: what puts a price and availability into a Google
// result rather than a bare blue link.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  ...(product.brand && { brand: { '@type': 'Brand', name: product.brand } }),
  ...(product.model && { model: product.model }),
  ...(heroImage && { image: [heroImage] }),
  ...(product.description && { description: product.description }),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    ...(product.price_cents && { price: (product.price_cents / 100).toFixed(2) }),
    availability: sold ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    itemCondition:
      product.condition === 'new'
        ? 'https://schema.org/NewCondition'
        : product.condition === 'for_parts'
          ? 'https://schema.org/DamagedCondition'
          : 'https://schema.org/UsedCondition',
    url: listingUrl,
    ...(business.name && { seller: { '@type': 'Organization', name: business.name } }),
  },
}

// Presence only, never verified: this decides whether to draw a toolbar, and
// verifying would mean a Supabase round trip on every public page view.
const signedIn = (Astro.request.headers.get('cookie') ?? '').includes('sb-')

const facts = [
  product.brand && { label: 'Brand', value: product.brand },
  product.model && { label: 'Model', value: product.model },
  category && { label: 'Category', value: category.name },
  { label: 'Condition', value: conditionLabel(product.condition) },
  { label: 'Availability', value: stockLabel(product.qty_available, business.show_exact_quantity) },
].filter(Boolean) as { label: string; value: string }[]
---

<Public
  business={business}
  title={product.name}
  description={description}
  image={heroImage}
  schema={[
    jsonLd,
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'All appliances', item: new URL('/appliances', site).toString() },
        ...(category
          ? [{
              '@type': 'ListItem',
              position: 2,
              name: category.name,
              item: new URL(`/appliances?category=${category.slug}`, site).toString(),
            }]
          : []),
        { '@type': 'ListItem', position: category ? 3 : 2, name: product.name, item: listingUrl },
      ],
    },
  ]}
>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    {signedIn && (
      <AdminBar
        productId={product.id}
        priceCents={product.price_cents}
        condition={product.condition}
        qtyAvailable={product.qty_available}
        photoCount={shots.length}
        sold={sold}
      />
    )}

    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1.5 text-sm text-ink-500">
      <a href="/appliances" class="hover:text-ink-900">All appliances</a>
      {category && (
        <>
          <span aria-hidden="true">/</span>
          <a href={`/appliances?category=${category.slug}`} class="hover:text-ink-900">{category.name}</a>
        </>
      )}
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div>
        <PhotoGallery shots={shots} name={product.name} sold={sold} />
      </div>

      <div>
        {product.brand && (
          <p class="text-sm font-medium tracking-wide text-ink-300 uppercase">{product.brand}</p>
        )}
        <h1 class="mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">{product.name}</h1>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <p class="text-4xl font-semibold tabular-nums">
            {product.price_cents ? formatCents(product.price_cents) : 'Ask for price'}
          </p>
          <span class:list={['rounded-md px-2.5 py-1 text-sm font-medium ring-1 ring-inset', conditionBadgeClass(product.condition)]}>
            {conditionLabel(product.condition)}
          </span>
        </div>
        <p class="mt-2 text-sm text-ink-500">{conditionNote(product.condition)}</p>

        <p class:list={['mt-4 text-sm font-medium', sold ? 'text-ink-500' : product.qty_available === 1 ? 'text-amber-700' : 'text-emerald-700']}>
          {sold ? 'This one has sold — ask about similar stock.' : stockLabel(product.qty_available, business.show_exact_quantity)}
        </p>

        {tel ? (
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href={sms} class="flex-1 rounded-xl bg-brand-600 px-6 py-3.5 text-center font-semibold text-white transition hover:bg-brand-700">
              Text about this
            </a>
            <a href={`tel:${tel}`} class="flex-1 rounded-xl border border-ink-200 bg-white px-6 py-3.5 text-center font-semibold text-ink-900 transition hover:bg-ink-50">
              Call {business.phone}
            </a>
          </div>
        ) : (
          <p class="mt-6 rounded-xl border border-dashed border-ink-100 p-4 text-sm text-ink-500">
            Contact details are being set up.
          </p>
        )}
        <p class="mt-2.5 text-xs text-ink-300">
          No account, no checkout — we arrange a time and you see it before you pay.
        </p>

        {product.description && (
          <div class="mt-8 border-t border-ink-100 pt-6">
            <h2 class="font-semibold">Details</h2>
            <p class="mt-2 whitespace-pre-line text-ink-500">{product.description}</p>
          </div>
        )}

        <div class="mt-8 border-t border-ink-100 pt-6">
          <h2 class="font-semibold">Specifications</h2>
          <dl class="mt-3 divide-y divide-ink-100 text-sm">
            {facts.map((f) => (
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-ink-500">{f.label}</dt>
                <dd class="text-right font-medium">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {(business.delivery || business.warranty) && (
          <div class="mt-8 space-y-4 rounded-xl bg-ink-50 p-5 text-sm">
            {business.delivery && (
              <div><p class="font-medium">Delivery</p><p class="mt-1 text-ink-500">{business.delivery}</p></div>
            )}
            {business.warranty && (
              <div><p class="font-medium">Warranty</p><p class="mt-1 text-ink-500">{business.warranty}</p></div>
            )}
          </div>
        )}
      </div>
    </div>

    {(related ?? []).length > 0 && (
      <section class="mt-20">
        <h2 class="text-2xl font-semibold tracking-tight">More like this</h2>
        <div class="mt-5 grid grid-cols-2 gap-4 lg:grid-cols-4">
          {(related ?? []).map((r) => (
            <ProductCard product={r} photo={relatedPhoto.get(r.id) ?? null} showExactQuantity={business.show_exact_quantity} />
          ))}
        </div>
      </section>
    )}
  </div>
</Public>
