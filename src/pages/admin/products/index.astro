---
import ConfirmAction from '../../../components/admin/ConfirmAction.astro'
import Admin from '../../../layouts/Admin.astro'
import { conditionBadgeClass, conditionLabel } from '../../../lib/condition.ts'
import { photoUrl } from '../../../lib/images/keys.ts'
import { formatCents } from '../../../lib/money.ts'

const supabase = Astro.locals.supabase!
let notice = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('intent') ?? '')
  // A row button sets `single_id`; the bulk bar uses the checkboxes.
  const single = String(form.get('single_id') ?? '')
  const ids = single ? [single] : form.getAll('ids').map(String).filter(Boolean)

  if (ids.length > 0 && (intent === 'delete' || intent === 'restore')) {
    // Soft delete only. The row stays, so sales history and lot P&L for
    // anything already sold remain correct.
    const status = intent === 'delete' ? 'deleted' : 'draft'
    const { error } = await supabase.from('products').update({ status }).in('id', ids)
    notice = error
      ? error.message
      : intent === 'delete'
        ? `${ids.length} product${ids.length === 1 ? '' : 's'} deleted. Restore them from the Deleted tab.`
        : `${ids.length} product${ids.length === 1 ? '' : 's'} restored as drafts.`
  }
}

const status = Astro.url.searchParams.get('status') ?? 'all'

let query = supabase
  .from('products')
  .select('id, name, brand, model, price_cents, msrp_cents, condition, status, category_id')
  .order('created_at', { ascending: false })
  .limit(300)

// "all" deliberately excludes deleted — they live behind their own tab.
if (status === 'all') query = query.neq('status', 'deleted')
else query = query.eq('status', status)

const [
  { data: products },
  { data: cats },
  { data: stock },
  { data: photoRows },
  { count: pendingImports },
  { count: draftCount },
  { count: deletedCount },
] = await Promise.all([
  query,
  supabase.from('categories').select('id, name'),
  supabase.from('product_stock').select('product_id, qty_available'),
  supabase.from('product_photos').select('product_id, r2_key').order('sort_order'),
  supabase.from('imports').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
  supabase.from('products').select('*', { count: 'exact', head: true }).eq('status', 'draft'),
  supabase.from('products').select('*', { count: 'exact', head: true }).eq('status', 'deleted'),
])

const catName = new Map((cats ?? []).map((c) => [c.id, c.name]))
const qty = new Map((stock ?? []).map((s) => [s.product_id, s.qty_available]))
// A listing without a picture is barely a listing, so the gap is worth showing
// in the same glance as the price.
const photoCount = new Map<string, number>()
// Ordered by sort_order, so the first one seen for a product is its main shot.
const mainPhoto = new Map<string, string>()
for (const r of photoRows ?? []) {
  photoCount.set(r.product_id, (photoCount.get(r.product_id) ?? 0) + 1)
  if (!mainPhoto.has(r.product_id)) mainPhoto.set(r.product_id, r.r2_key)
}
const missingPhotos = (products ?? []).filter((p) => !photoCount.get(p.id)).length
const list = products ?? []
const created = Astro.url.searchParams.get('created')
const published = Astro.url.searchParams.get('published')
const unpriced = Astro.url.searchParams.get('unpriced')
const viewingDeleted = status === 'deleted'

const filters = ['all', 'draft', 'active', 'sold', 'hidden']
---

<Admin title="Products" subtitle="Everything in your catalog.">
  {notice && <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">{notice}</p>}

  {Astro.url.searchParams.get('deleted') && (
    <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      Product deleted. It's in the <a href="/admin/products?status=deleted" class="font-medium underline underline-offset-2">Deleted tab</a> if you want it back.
    </p>
  )}

  {created && (
    <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      Import committed — {created} product{created === '1' ? '' : 's'} created as drafts.
    </p>
  )}

  {published && (
    <p class="mb-5 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      <strong>{published} product{published === '1' ? '' : 's'} published</strong> — live on the site now.
      {unpriced && ` ${unpriced} left as ${unpriced === '1' ? 'a draft' : 'drafts'} for want of a price.`}
      {' '}That's the truckload done.
    </p>
  )}

  {(draftCount ?? 0) > 0 && !viewingDeleted && (
    <div class="mb-5 flex flex-wrap items-center gap-3 rounded-xl border border-brand-500/30 bg-brand-500/[0.04] p-4">
      <div class="min-w-0 flex-1">
        <p class="font-medium">{draftCount} draft{(draftCount ?? 0) === 1 ? '' : 's'} need pricing</p>
        <p class="mt-0.5 text-sm text-ink-500">
          Drafts are invisible to customers. Set prices and publish to put them on the site.
        </p>
      </div>
      <a href="/admin/products/pricing"
        class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-700">
        Set prices →
      </a>
    </div>
  )}

  <div class="mb-4 flex flex-wrap items-center gap-1">
    {filters.map((f) => (
      <a href={f === 'all' ? '/admin/products' : `/admin/products?status=${f}`}
        class:list={['rounded-lg px-3 py-1.5 text-sm font-medium capitalize transition',
          status === f ? 'bg-brand-500/10 text-brand-700' : 'text-ink-500 hover:bg-ink-100']}>
        {f}
      </a>
    ))}
    {(deletedCount ?? 0) > 0 && (
      <a href="/admin/products?status=deleted"
        class:list={['ml-auto rounded-lg px-3 py-1.5 text-sm font-medium transition',
          viewingDeleted ? 'bg-red-100 text-red-700' : 'text-ink-300 hover:bg-ink-100']}>
        Deleted ({deletedCount})
      </a>
    )}
  </div>

  {list.length === 0 ? (
    <div class="rounded-xl border border-dashed border-ink-100 bg-white p-10 text-center">
      <p class="font-medium">{viewingDeleted ? 'Nothing deleted' : 'No products yet'}</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
        {viewingDeleted
          ? 'Deleted products would appear here, and can be restored.'
          : (pendingImports ?? 0) > 0
            ? `You have ${pendingImports} manifest${pendingImports === 1 ? '' : 's'} staged. Products appear here once you review and commit them.`
            : 'Import a manifest or add an appliance by hand to get started.'}
      </p>
      {!viewingDeleted && (pendingImports ?? 0) > 0 && (
        <a href="/admin/import"
          class="mt-4 inline-block rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-brand-700">
          Review imports →
        </a>
      )}
    </div>
  ) : (
    <form method="POST" id="bulk">
      <div class="overflow-x-auto rounded-xl border border-ink-100 bg-white">
        <table class="w-full text-sm">
          <thead class="border-b border-ink-100 text-left text-xs tracking-wide text-ink-500 uppercase">
            <tr>
              <th class="w-10 px-3 py-3">
                <input type="checkbox" id="all" class="size-4 rounded border-ink-300" aria-label="Select all" />
              </th>
              <th class="px-4 py-3 font-medium">Product</th>
              <th class="px-4 py-3 font-medium">Category</th>
              <th class="px-4 py-3 text-right font-medium">In stock</th>
              <th class="px-4 py-3 font-medium">Condition</th>
              <th class="px-4 py-3 text-right font-medium">MSRP</th>
              <th class="px-4 py-3 text-right font-medium">Your price</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {list.map((p) => (
              <tr class="hover:bg-ink-50/60">
                <td class="px-3 py-3">
                  <input type="checkbox" name="ids" value={p.id} class="row size-4 rounded border-ink-300" aria-label={`Select ${p.name}`} />
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    {mainPhoto.get(p.id) ? (
                      <a href={`/admin/photos?product=${p.id}`} class="relative shrink-0" title="Manage photos">
                        <img
                          src={photoUrl(mainPhoto.get(p.id)!, 'thumb')}
                          alt=""
                          loading="lazy"
                          width="44"
                          height="44"
                          class="size-11 rounded-md border border-ink-100 bg-ink-50 object-cover"
                        />
                        {(photoCount.get(p.id) ?? 0) > 1 && (
                          <span class="absolute -right-1 -bottom-1 rounded-full bg-ink-900/80 px-1.5 text-[10px] font-medium text-white tabular-nums">
                            {photoCount.get(p.id)}
                          </span>
                        )}
                      </a>
                    ) : (
                      <a
                        href={`/admin/photos?product=${p.id}`}
                        title="No photo yet — add one"
                        class="flex size-11 shrink-0 items-center justify-center rounded-md border border-dashed border-amber-300 bg-amber-50 text-amber-700 transition hover:border-amber-400 hover:bg-amber-100"
                      >
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                          <path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2L8 5h8l1.5 2h2A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-9Z" stroke-linejoin="round"/>
                          <circle cx="12" cy="13" r="3.2"/>
                        </svg>
                        <span class="sr-only">Add a photo for {p.name}</span>
                      </a>
                    )}
                    <div class="min-w-0">
                      <a href={`/admin/products/${p.id}`} class="font-medium hover:text-brand-600 hover:underline">{p.name}</a>
                      <div class="text-xs text-ink-300">{[p.brand, p.model].filter(Boolean).join(' · ')}</div>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-ink-500">{p.category_id ? catName.get(p.category_id) : '—'}</td>
                <td class="px-4 py-3 text-right tabular-nums">{qty.get(p.id) ?? 0}</td>
                <td class="px-4 py-3">
                  <span class:list={['rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset',
                    conditionBadgeClass(p.condition)]}>{conditionLabel(p.condition)}</span>
                </td>
                <td class="px-4 py-3 text-right tabular-nums text-ink-500">{formatCents(p.msrp_cents)}</td>
                <td class="px-4 py-3 text-right tabular-nums font-medium">
                  {p.price_cents ? formatCents(p.price_cents)
                    : <span class="rounded-md bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">needs price</span>}
                </td>
                <td class="px-4 py-3">
                  <span class:list={['rounded-md px-2 py-0.5 text-xs font-medium',
                    p.status === 'active' ? 'bg-emerald-100 text-emerald-800'
                    : p.status === 'draft' ? 'bg-ink-100 text-ink-500'
                    : p.status === 'sold' ? 'bg-blue-100 text-blue-800'
                    : p.status === 'deleted' ? 'bg-red-100 text-red-700'
                    : 'bg-amber-100 text-amber-800']}>{p.status}</span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  {viewingDeleted ? (
                    <ConfirmAction intent="restore" label="Restore"
                      title="Restore this product?"
                      message={`"${p.name}" comes back as a draft, so you can check it before putting it back on the site.`}
                      confirmLabel="Restore" tone="warn"
                      fieldName="single_id" fieldValue={p.id}
                      class="text-sm font-medium text-brand-600 hover:underline" />
                  ) : (
                    <ConfirmAction intent="delete" label="Delete"
                      title="Delete this product?"
                      message={`"${p.name}" comes off the site. Its sales history is kept and you can restore it from the Deleted tab.`}
                      confirmLabel="Delete" tone="danger"
                      fieldName="single_id" fieldValue={p.id}
                      class="text-sm text-red-600 hover:underline" />
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div id="bulkbar" class="sticky bottom-0 mt-4 hidden flex-wrap items-center gap-3 rounded-xl border border-ink-100 bg-white/95 p-4 backdrop-blur">
        <span class="flex-1 text-sm text-ink-500"><span id="count">0</span> selected</span>
        {viewingDeleted ? (
          <ConfirmAction intent="restore" label="Restore selected"
            title="Restore the selected products?"
            message="They come back as drafts, so you can check them before putting them back on the site."
            confirmLabel="Restore" tone="warn"
            class="rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white transition hover:bg-brand-700" />
        ) : (
          <ConfirmAction intent="delete" label="Delete selected"
            title="Delete the selected products?"
            message="They come off the site. Their sales history is kept and you can restore them from the Deleted tab."
            confirmLabel="Delete" tone="danger"
            class="rounded-lg bg-red-600 px-5 py-2.5 font-medium text-white transition hover:bg-red-700" />
        )}
      </div>
    </form>

    <script is:inline>
      const bar = document.getElementById('bulkbar')
      const count = document.getElementById('count')
      const rows = () => [...document.querySelectorAll('.row')]
      const sync = () => {
        const n = rows().filter((c) => c.checked).length
        count.textContent = String(n)
        bar.classList.toggle('hidden', n === 0)
        bar.classList.toggle('flex', n > 0)
      }
      document.getElementById('all')?.addEventListener('change', (e) => {
        for (const c of rows()) c.checked = e.target.checked
        sync()
      })
      for (const c of rows()) c.addEventListener('change', sync)
    </script>
  )}
</Admin>
