---
/**
 * Photo upload for one product.
 *
 * `accept="image/*"` with no `capture` attribute is deliberate: on a phone it
 * offers the camera *and* the gallery, which matters because half the photos
 * get taken before anyone opens the admin.
 *
 * Resizing happens on the device before upload -- see lib/images/resize.ts.
 */
import { photoUrl } from '../../lib/images/keys.ts'

interface Photo {
  id: string
  r2_key: string
  format?: 'webp' | 'jpeg' | null
  alt_text?: string | null
}

interface Props {
  productId: string
  photos: Photo[]
  /** Compact variant for the walk-the-warehouse screen. */
  compact?: boolean
}

const { productId, photos, compact = false } = Astro.props
---

<div
  class="photo-uploader"
  data-product={productId}
  data-count={photos.length}
>
  <div
    class:list={[
      'grid gap-3',
      compact ? 'grid-cols-3 sm:grid-cols-4' : 'grid-cols-2 sm:grid-cols-3',
    ]}
    data-grid
  >
    {photos.map((p, i) => (
      <figure class="group relative aspect-square overflow-hidden rounded-lg border border-ink-100 bg-ink-50" data-photo={p.id}>
        <img
          src={photoUrl(p.r2_key, 'thumb', p.format ?? 'webp')}
          alt={p.alt_text ?? ''}
          loading="lazy"
          class="size-full object-cover"
        />
        {i === 0 && (
          <figcaption class="absolute top-1 left-1 rounded bg-ink-900/70 px-1.5 py-0.5 text-[10px] font-medium text-white">
            Main
          </figcaption>
        )}
        <button
          type="button"
          data-remove={p.id}
          aria-label="Remove this photo"
          class="absolute top-1 right-1 rounded-full bg-ink-900/70 px-2 py-0.5 text-xs font-medium text-white opacity-0 transition group-hover:opacity-100 focus:opacity-100"
        >Remove</button>
      </figure>
    ))}

    <label
      class:list={[
        'flex aspect-square cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed border-ink-100 text-center transition hover:border-brand-500 hover:bg-brand-500/[0.04]',
      ]}
      data-add
    >
      <svg class="size-7 text-ink-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2L8 5h8l1.5 2h2A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-9Z" stroke-linejoin="round"/>
        <circle cx="12" cy="13" r="3.2"/>
      </svg>
      <span class="px-2 text-xs font-medium text-ink-500">Add photos</span>
      <input type="file" accept="image/*" multiple class="sr-only" data-input />
    </label>
  </div>

  <p class="mt-2 text-xs text-ink-300" data-status role="status" aria-live="polite"></p>
</div>

<script>
  import { renderSizes } from '../../lib/images/resize.ts'

  const SIZES = ['thumb', 'card', 'full'] as const

  function wire(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!
    const addLabel = root.querySelector<HTMLElement>('[data-add]')!
    const input = root.querySelector<HTMLInputElement>('[data-input]')!
    const status = root.querySelector<HTMLElement>('[data-status]')!
    const productId = root.dataset.product!

    const say = (msg: string, tone: 'info' | 'error' = 'info') => {
      status.textContent = msg
      status.className = `mt-2 text-xs ${tone === 'error' ? 'font-medium text-red-700' : 'text-ink-300'}`
    }

    const bumpCount = (delta: number) => {
      const next = Number(root.dataset.count || 0) + delta
      root.dataset.count = String(next)
      // The queue screen listens for this to know when to offer the next product.
      root.dispatchEvent(
        new CustomEvent('photos:changed', { bubbles: true, detail: { productId, count: next } }),
      )
    }

    /** A placeholder tile so the upload is visible while it is happening. */
    function placeholder(): HTMLElement {
      const el = document.createElement('div')
      el.className =
        'flex aspect-square items-center justify-center rounded-lg border border-ink-100 bg-ink-50 text-xs text-ink-300'
      el.textContent = 'Uploading…'
      grid.insertBefore(el, addLabel)
      return el
    }

    function tile(id: string, src: string, isFirst: boolean): HTMLElement {
      const fig = document.createElement('figure')
      fig.className =
        'group relative aspect-square overflow-hidden rounded-lg border border-ink-100 bg-ink-50'
      fig.dataset.photo = id
      fig.innerHTML =
        `<img src="${src}" alt="" class="size-full object-cover" />` +
        (isFirst
          ? '<figcaption class="absolute top-1 left-1 rounded bg-ink-900/70 px-1.5 py-0.5 text-[10px] font-medium text-white">Main</figcaption>'
          : '') +
        `<button type="button" data-remove="${id}" aria-label="Remove this photo" class="absolute top-1 right-1 rounded-full bg-ink-900/70 px-2 py-0.5 text-xs font-medium text-white opacity-0 transition group-hover:opacity-100 focus:opacity-100">Remove</button>`
      return fig
    }

    input.addEventListener('change', async () => {
      const files = [...(input.files ?? [])]
      input.value = '' // so re-picking the same file fires change again
      if (!files.length) return

      let done = 0
      const failures: string[] = []
      const mb = (n: number) => (n / 1_048_576).toFixed(1) + ' MB'
      for (const [n, file] of files.entries()) {
        const slot = placeholder()
        const label = files.length > 1 ? `${file.name} (${n + 1} of ${files.length})` : file.name
        try {
          say(`Resizing ${label} — ${mb(file.size)}…`)
          const rendered = await renderSizes(file)

          const body = new FormData()
          body.set('product_id', productId)
          const full = rendered.find((r) => r.size === 'full')!
          body.set('width', String(full.width))
          body.set('height', String(full.height))
          for (const r of rendered) {
            // The blob's own type, never an assumed one: Safari hands back
            // JPEG when asked for WebP, and mislabelling it here is what made
            // an iPhone upload look like an oversized WebP.
            const ext = r.type === 'image/jpeg' ? 'jpg' : 'webp'
            body.set(r.size, new File([r.blob], `${r.size}.${ext}`, { type: r.type }))
          }

          const kb = Math.round(rendered.reduce((a, r) => a + r.blob.size, 0) / 1024)
          // Both numbers on screen: it is the quickest way to see that the
          // phone really did shrink the photo before sending it.
          say(`Uploading ${label} — ${mb(file.size)} shrunk to ${kb} KB…`)

          const res = await fetch('/api/admin/photos', { method: 'POST', body })
          const data = (await res.json()) as {
            photo?: { id: string; r2_key: string; format: string }
            error?: string
          }
          if (!res.ok || !data.photo) throw new Error(data.error ?? 'Upload failed.')

          const isFirst = Number(root.dataset.count || 0) === 0
          grid.insertBefore(
            tile(data.photo.id, `/img/${data.photo.r2_key}-thumb.${data.photo.format}`, isFirst),
            addLabel,
          )
          bumpCount(1)
          done++
        } catch (e) {
          // Collected rather than shown immediately: the next file's progress
          // would otherwise wipe the only explanation of what went wrong.
          failures.push(`${file.name}: ${e instanceof Error ? e.message : 'failed'}`)
        } finally {
          slot.remove()
        }
      }
      if (failures.length) {
        say(failures.join(' · '), 'error')
      } else if (done) {
        say(`${done} photo${done === 1 ? '' : 's'} added.`)
      }
    })

    root.addEventListener('click', async (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-remove]')
      if (!btn) return
      const id = btn.dataset.remove!
      btn.textContent = '…'
      const res = await fetch('/api/admin/photos', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id }),
      })
      if (res.ok) {
        root.querySelector(`[data-photo="${id}"]`)?.remove()
        bumpCount(-1)
        say('Photo removed.')
      } else {
        btn.textContent = 'Remove'
        say('Could not remove that photo.', 'error')
      }
    })
  }

  for (const el of document.querySelectorAll<HTMLElement>('.photo-uploader')) wire(el)
</script>
