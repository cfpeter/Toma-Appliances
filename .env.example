# ─────────────────────────────────────────────────────────────
# Toma Appliances — environment variables
#
# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys

# Project URL — safe to expose
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (starts sb_publishable_...)
# Safe in the browser — Row Level Security is what protects the data.
# On older projects this is called the "anon" key and is a long JWT.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 🔴 SECRET — secret key (starts sb_secret_...)
# Bypasses ALL database security. Server-side only, never in a browser.
# On older projects this is called the "service_role" key.
# Not read by the app: every request runs as the signed-in user under RLS.
# Kept for one-off admin queries from the command line.
SUPABASE_SECRET_KEY=

# Pooler host, e.g. aws-0-us-west-1.pooler.supabase.com (find it in the
# dashboard under Connect). The direct db.<ref> host is IPv6-only.
SUPABASE_DB_HOST=

# 🔴 SECRET — Postgres password, used only for running migrations
SUPABASE_DB_PASSWORD=

# ── Site ────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321

# ── Cloudflare R2 ───────────────────────────────────────────
# Photos use the PHOTOS binding in wrangler.jsonc -- no access keys, and the
# bucket name lives there too, so it is not repeated here.
# Leave blank: images are then served by the /img route from the binding, which
# works locally and on a fresh deploy. Set it to https://img.<your-domain>
# only once the bucket has a custom domain attached.
PUBLIC_IMAGE_BASE_URL=

